<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>d2b44c70-d52e-4581-a233-f09e592bf9e5</Id>
  <Version>1.9.0.0</Version>
  <ProviderName>Go India Stocks</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="GoIndia Stocks for Excel"/>
  <Description DefaultValue="Get company data in excel at the click of a button"/>
  <IconUrl DefaultValue="https://goindia-addin.netlify.app/assets/logo32.png"/>
  <HighResolutionIconUrl DefaultValue="https://goindia-addin.netlify.app/assets/logo64.png"/>
  <SupportUrl DefaultValue="https://www.goindiastocks.com/exceladdin"/>
  <AppDomains>
    <AppDomain>https://pranavdole11.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <!-- Custom Functions spike (Phase 0) — see
       C:\Users\prana\.claude\plans\mellow-hopping-whisper.md. SharedRuntime, not a separate
       JS-only custom-functions runtime: the whole point is that functions.js executes in the
       SAME page/context as the task pane (see the Runtimes/CustomFunctions ExtensionPoint below,
       both pointing at Taskpane.Url), so it shares the task pane's own localStorage identity by
       construction instead of needing OfficeRuntime.storage as a bridge. -->
  <Requirements>
    <Sets>
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://goindia-addin.netlify.app/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!-- Custom Functions spike — see the top-level <Requirements> comment above for why this
             is SharedRuntime pointed at the task pane's own page (Taskpane.Url), not a dedicated
             one. lifetime="long" keeps this runtime alive in the background once Excel has loaded
             it, independent of whether the visible task pane UI is currently open — that's what
             lets a =GIA.* formula keep working after the user closes the task pane. -->
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Functions.Script.Url"/>
            </Script>
            <Page>
              <SourceLocation resid="Taskpane.Url"/>
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url"/>
            </Metadata>
            <Namespace resid="Functions.Namespace"/>
          </ExtensionPoint>
        </AllFormFactors>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <!-- The Home-tab entry point (OfficeTab id="TabHome" > CommandsGroup >
                 TaskpaneButton) was REMOVED deliberately: the side-panel-first UI has been
                 retired in favour of the "GoIndia Stocks" custom tab below, which is now the
                 single entry point for every feature. Note there is no Office.js way to make a
                 button switch the user to a ribbon tab (Office.Ribbon only exposes
                 requestCreateControls/requestUpdate — visibility and enabled-state only, never
                 tab activation), so a Home-tab button pointing at this tab was not possible;
                 removing it entirely is the only way to make the custom tab unambiguous. -->
            <CustomTab id="GoIndiaTab">
              <Group id="DataGroup">
                <Label resid="DataGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.Download.16x16"/>
                  <bt:Image size="32" resid="Icon.Download.32x32"/>
                  <bt:Image size="80" resid="Icon.Download.80x80"/>
                </Icon>
                <!-- "Get Financials" (user-facing name) — internal id/url/resource names
                     (DownloadDataButton, Taskpane.Download.Url, .Label/.Tooltip) kept as-is, same
                     precedent as DownloadTableButton below: only the user-facing text and icon
                     changed, not the plumbing taskpane.js/html route on. -->
                <Control xsi:type="Button" id="DownloadDataButton">
                  <Label resid="DownloadDataButton.Label"/>
                  <Supertip>
                    <Title resid="DownloadDataButton.Label"/>
                    <Description resid="DownloadDataButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Rupee.16x16"/>
                    <bt:Image size="32" resid="Icon.Rupee.32x32"/>
                    <bt:Image size="80" resid="Icon.Rupee.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Download.Url"/>
                  </Action>
                </Control>
                <!-- "Formula Wizard" (user-facing name; PROTOTYPE) — renamed again from "Table
                     Builder", which itself replaced the earlier dropdown-based Download Table
                     feature, itself since renamed again from "Query Data". Internal ids
                     (DownloadTableButton, Taskpane.DownloadTable.Url, DownloadTableButton.
                     Label/.Tooltip) are kept as-is on purpose, matching taskpane.js/html's
                     ?view=downloadtable — only the user-facing label/tooltip text and icon
                     changed, same precedent as every previous rename. -->
                <Control xsi:type="Button" id="DownloadTableButton">
                  <Label resid="DownloadTableButton.Label"/>
                  <Supertip>
                    <Title resid="DownloadTableButton.Label"/>
                    <Description resid="DownloadTableButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.FormulaWizard.16x16"/>
                    <bt:Image size="32" resid="Icon.FormulaWizard.32x32"/>
                    <bt:Image size="80" resid="Icon.FormulaWizard.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.DownloadTable.Url"/>
                  </Action>
                </Control>
              </Group>
              <Group id="ChatGroup">
                <Label resid="ChatGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.Chat.16x16"/>
                  <bt:Image size="32" resid="Icon.Chat.32x32"/>
                  <bt:Image size="80" resid="Icon.Chat.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="AskDataGPTButton">
                  <Label resid="AskDataGPTButton.Label"/>
                  <Supertip>
                    <Title resid="AskDataGPTButton.Label"/>
                    <Description resid="AskDataGPTButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Chat.16x16"/>
                    <bt:Image size="32" resid="Icon.Chat.32x32"/>
                    <bt:Image size="80" resid="Icon.Chat.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.DataGPT.Url"/>
                  </Action>
                </Control>
              </Group>
              <Group id="FeedbackGroup">
                <Label resid="FeedbackGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.Feedback.16x16"/>
                  <bt:Image size="32" resid="Icon.Feedback.32x32"/>
                  <bt:Image size="80" resid="Icon.Feedback.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="FeedbackButton">
                  <Label resid="FeedbackButton.Label"/>
                  <Supertip>
                    <Title resid="FeedbackButton.Label"/>
                    <Description resid="FeedbackButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Feedback.16x16"/>
                    <bt:Image size="32" resid="Icon.Feedback.32x32"/>
                    <bt:Image size="80" resid="Icon.Feedback.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Feedback.Url"/>
                  </Action>
                </Control>
              </Group>
              <Group id="AccountGroup">
                <Label resid="AccountGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.Account.16x16"/>
                  <bt:Image size="32" resid="Icon.Account.32x32"/>
                  <bt:Image size="80" resid="Icon.Account.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="ProfileButton">
                  <Label resid="ProfileButton.Label"/>
                  <Supertip>
                    <Title resid="ProfileButton.Label"/>
                    <Description resid="ProfileButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Account.16x16"/>
                    <bt:Image size="32" resid="Icon.Account.32x32"/>
                    <bt:Image size="80" resid="Icon.Account.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Profile.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="LogoutButton">
                  <Label resid="LogoutButton.Label"/>
                  <Supertip>
                    <Title resid="LogoutButton.Label"/>
                    <Description resid="LogoutButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Exit.16x16"/>
                    <bt:Image size="32" resid="Icon.Exit.32x32"/>
                    <bt:Image size="80" resid="Icon.Exit.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>logoutUser</FunctionName>
                  </Action>
                </Control>
              </Group>
              <Label resid="GoIndiaTab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/logo16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/logo32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/logo64.png"/>
        <bt:Image id="Icon.Download.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-download-16.png"/>
        <bt:Image id="Icon.Download.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-download-32.png"/>
        <bt:Image id="Icon.Download.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-download-80.png"/>
        <bt:Image id="Icon.Chat.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-chat-16.png"/>
        <bt:Image id="Icon.Chat.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-chat-32.png"/>
        <bt:Image id="Icon.Chat.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-chat-80.png"/>
        <bt:Image id="Icon.Account.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-account-16.png"/>
        <bt:Image id="Icon.Account.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-account-32.png"/>
        <bt:Image id="Icon.Account.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-account-80.png"/>
        <bt:Image id="Icon.Exit.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-exit-16.png"/>
        <bt:Image id="Icon.Exit.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-exit-32.png"/>
        <bt:Image id="Icon.Exit.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-exit-80.png"/>
        <bt:Image id="Icon.Feedback.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-feedback-16.png"/>
        <bt:Image id="Icon.Feedback.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-feedback-32.png"/>
        <bt:Image id="Icon.Feedback.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-feedback-80.png"/>
        <bt:Image id="Icon.Query.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-search-16.png"/>
        <bt:Image id="Icon.Query.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-search-32.png"/>
        <bt:Image id="Icon.Query.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-search-80.png"/>
        <!-- "Get Financials" (DownloadDataButton) — a Rupee symbol, replacing the old download
             arrow now that the button itself no longer reads as a generic "download" action. -->
        <bt:Image id="Icon.Rupee.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-rupee-16.png"/>
        <bt:Image id="Icon.Rupee.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-rupee-32.png"/>
        <bt:Image id="Icon.Rupee.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-rupee-80.png"/>
        <!-- "Table Builder" (DownloadTableButton) — a spreadsheet grid with a red "+" badge,
             replacing the old magnifying-glass (Icon.Query.*, kept above — no longer referenced
             by any control — in case a future revision wants it back). No longer referenced by
             DownloadTableButton itself (renamed "Formula Wizard", see Icon.FormulaWizard.* below)
             — kept in case a future revision wants it back, same precedent as Icon.Query.* above. -->
        <bt:Image id="Icon.SheetPlus.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-sheet-plus-16.png"/>
        <bt:Image id="Icon.SheetPlus.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-sheet-plus-32.png"/>
        <bt:Image id="Icon.SheetPlus.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-sheet-plus-80.png"/>
        <!-- "Formula Wizard" (DownloadTableButton, renamed from "Table Builder") — no background
             box (confirmed live: a navy box read wrong against the ribbon's own light background —
             matches Icon.Rupee's own box-less style instead, see its comment above). Just a navy
             (#173760) italic "f" — the same math-notation f(x) glyph used throughout this
             feature's own UI, e.g. the Formula Picker panel's own title icon — with a small red
             (#d80404) star accent, same navy/red brand pairing DESIGN_SYSTEM.md documents. -->
        <bt:Image id="Icon.FormulaWizard.16x16" DefaultValue="https://goindia-addin.netlify.app/assets/icon-formula-wizard-16.png"/>
        <bt:Image id="Icon.FormulaWizard.32x32" DefaultValue="https://goindia-addin.netlify.app/assets/icon-formula-wizard-32.png"/>
        <bt:Image id="Icon.FormulaWizard.80x80" DefaultValue="https://goindia-addin.netlify.app/assets/icon-formula-wizard-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="App.PrivacyUrl" DefaultValue="https://www.goindiastocks.com/exceladdin"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://goindia-addin.netlify.app/commands.html"/>
        <!-- Custom Functions spike — bare taskpane.html (no ?view=), used as the SharedRuntime's
             own Page/Runtime SourceLocation (see Requirements/Runtimes above). The view query
             string only controls which part of the SPA taskpane.js shows on load; it's irrelevant
             here since CustomFunctions.associate(...) runs at top-level script execution
             regardless of it. -->
        <bt:Url id="Taskpane.Url" DefaultValue="https://goindia-addin.netlify.app/taskpane.html"/>
        <bt:Url id="Functions.Script.Url" DefaultValue="https://goindia-addin.netlify.app/functions.js"/>
        <bt:Url id="Functions.Metadata.Url" DefaultValue="https://goindia-addin.netlify.app/functions.json"/>
        <bt:Url id="Taskpane.DataGPT.Url" DefaultValue="https://goindia-addin.netlify.app/taskpane.html?view=datagpt"/>
        <bt:Url id="Taskpane.Download.Url" DefaultValue="https://goindia-addin.netlify.app/taskpane.html?view=download"/>
        <bt:Url id="Taskpane.DownloadTable.Url" DefaultValue="https://goindia-addin.netlify.app/taskpane.html?view=downloadtable"/>
        <bt:Url id="Taskpane.Profile.Url" DefaultValue="https://goindia-addin.netlify.app/taskpane.html?view=profile"/>
        <bt:Url id="Taskpane.Feedback.Url" DefaultValue="https://goindia-addin.netlify.app/taskpane.html?view=feedback"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with Go India's add-in!"/>
        <bt:String id="GoIndiaTab.Label" DefaultValue="GoIndia Stocks"/>
        <bt:String id="DataGroup.Label" DefaultValue="Data"/>
        <bt:String id="DownloadDataButton.Label" DefaultValue="Get Financials"/>
        <bt:String id="DownloadTableButton.Label" DefaultValue="Formula Wizard"/>
        <bt:String id="ChatGroup.Label" DefaultValue="DataGPT"/>
        <bt:String id="AskDataGPTButton.Label" DefaultValue="Ask DataGPT"/>
        <bt:String id="FeedbackGroup.Label" DefaultValue="Feedback"/>
        <bt:String id="FeedbackButton.Label" DefaultValue="Feedback"/>
        <bt:String id="AccountGroup.Label" DefaultValue="Account"/>
        <bt:String id="ProfileButton.Label" DefaultValue="Profile"/>
        <bt:String id="LogoutButton.Label" DefaultValue="Log Out"/>
        <!-- Custom Functions spike — formula prefix, e.g. =GIA.PING(). -->
        <bt:String id="Functions.Namespace" DefaultValue="GIA"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Go India Stocks add-in loaded successfully. Open the 'GoIndia Stocks' tab in the ribbon at the top of Excel to download company data, ask DataGPT, and view your profile."/>
        <bt:String id="DownloadDataButton.Tooltip" DefaultValue="Open a focused view to search for a company, choose data sources, optionally enable the AI Financial Model, and download — all in one place"/>
        <bt:String id="DownloadTableButton.Tooltip" DefaultValue="Describe what data you want in plain English — the AI picks the right tables and builds the query for you"/>
        <bt:String id="AskDataGPTButton.Tooltip" DefaultValue="Open the side panel with DataGPT chat only"/>
        <bt:String id="FeedbackButton.Tooltip" DefaultValue="Send feedback about a company's data to the GoIndia team"/>
        <bt:String id="ProfileButton.Tooltip" DefaultValue="View your profile, wallet balance and history, and the disclaimer"/>
        <bt:String id="LogoutButton.Tooltip" DefaultValue="Sign out of Go India Stocks"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
